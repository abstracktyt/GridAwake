<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- App identity -->
    <key>CFBundleName</key>
    <string>GridAwake</string>
    <key>CFBundleDisplayName</key>
    <string>GridAwake</string>
    <key>CFBundleIdentifier</key>
    <string>com.abstrackt.GridAwake</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0.0</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>

    <!-- Minimum iOS -->
    <key>MinimumOSVersion</key>
    <string>16.0</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>

    <!-- Supported orientations (iPhone) -->
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
    </array>

    <!-- Camera permission (for QR scanner) -->
    <key>NSCameraUsageDescription</key>
    <string>GridAwake uses the camera to scan QR codes for quick PC connection setup.</string>

    <!-- Local Network (for WoL broadcast + HTTP requests) -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>GridAwake needs local network access to send Wake-on-LAN packets and communicate with the PC agent.</string>

    <!-- Bonjour services (required with NSLocalNetworkUsageDescription) -->
    <key>NSBonjourServices</key>
    <array>
        <string>_gridawake._tcp</string>
    </array>

    <!-- Allow HTTP (non-TLS) to local IP addresses -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
        <!-- Fallback: allow arbitrary loads if needed for dev -->
        <!-- <key>NSAllowsArbitraryLoads</key><true/> -->
    </dict>

    <!-- Scene / SwiftUI lifecycle -->
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <false/>
        <key>UISceneConfigurations</key>
        <dict/>
    </dict>

    <key>UILaunchScreen</key>
    <dict>
        <key>UIImageRespectsSafeAreaInsets</key>
        <true/>
    </dict>

    <!-- Custom URL Scheme for Deep Linking -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.abstrackt.GridAwake</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>gridawake</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
